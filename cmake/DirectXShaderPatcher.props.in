<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup>
    <IncludePath>$(MSBuildThisFileDirectory)include;$(IncludePath)</IncludePath>
    <DXPSdkToolsetSubdir Condition="'$(PlatformToolset)'=='ClangCL'">clang</DXPSdkToolsetSubdir>
    <DXPSdkToolsetSubdir Condition="'$(PlatformToolset)'!='ClangCL'">msvc</DXPSdkToolsetSubdir>
    <!--
      Defaults to the current MSBuild configuration (Debug/Release). Override
      this before importing the props when consuming split SDK packages that
      publish a single configuration per root.
    -->
    <DXPSdkLibraryConfiguration Condition="'$(DXPSdkLibraryConfiguration)'=='' and $([System.String]::Copy('$(Configuration)').Contains('Debug'))">Debug</DXPSdkLibraryConfiguration>
    <DXPSdkLibraryConfiguration Condition="'$(DXPSdkLibraryConfiguration)'=='' and $([System.String]::Copy('$(Configuration)').Contains('Release'))">Release</DXPSdkLibraryConfiguration>
    <DXPSdkLibraryConfiguration Condition="'$(DXPSdkLibraryConfiguration)'==''">$(Configuration)</DXPSdkLibraryConfiguration>
    <LibraryPath Condition="Exists('$(MSBuildThisFileDirectory)lib\$(DXPSdkLibraryConfiguration)\$(DXPSdkToolsetSubdir)')">$(MSBuildThisFileDirectory)lib\$(DXPSdkLibraryConfiguration)\$(DXPSdkToolsetSubdir);$(LibraryPath)</LibraryPath>
    <LibraryPath Condition="!Exists('$(MSBuildThisFileDirectory)lib\$(DXPSdkLibraryConfiguration)\clang') and !Exists('$(MSBuildThisFileDirectory)lib\$(DXPSdkLibraryConfiguration)\msvc')">$(MSBuildThisFileDirectory)lib\$(DXPSdkLibraryConfiguration);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH;$(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>@DXP_SDK_MSBUILD_DEPENDENCIES@;$(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /y /d "$(MSBuildThisFileDirectory)bin\dxcompiler.dll" "$(TargetDir)"</Command>
      <Message>Copying DirectXShaderPatcher runtime dependencies next to output application...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>