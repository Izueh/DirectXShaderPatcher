{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "ninja-x64",
      "inherits": "base",
      "displayName": "Ninja x64",
      "description": "Primary build with Ninja and MSVC",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "ninja-x86",
      "inherits": "base",
      "displayName": "Ninja x86",
      "description": "SM5-only build (no LLVM/DXIL)",
      "binaryDir": "${sourceDir}/out/build32/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_MODULE_LINKER_FLAGS": "/machine:X86",
        "DXP_ARCH": "x86"
      }
    },
    {
      "name": "clang-x64",
      "inherits": "base",
      "displayName": "Clang x64",
      "description": "Clang-cl + Ninja (SM5 + SM6)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe"
      }
    },
    {
      "name": "clang-x86",
      "inherits": "base",
      "displayName": "Clang x86",
      "description": "SM5-only build (no LLVM/DXIL)",
      "binaryDir": "${sourceDir}/out/build32/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_MODULE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_STATIC_LINKER_FLAGS": "/machine:X86",
        "DXP_ARCH": "x86"
      }
    },
    {
      "name": "ninja-x64-static",
      "inherits": "base",
      "displayName": "Ninja x64 (Static CRT /MT)",
      "description": "Primary build with Ninja and MSVC",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "DXP_CRT": "Static"
      }
    },
    {
      "name": "ninja-x86-static",
      "inherits": "base",
      "displayName": "Ninja x86 (Static CRT /MT)",
      "description": "SM5-only build (no LLVM/DXIL)",
      "binaryDir": "${sourceDir}/out/build32/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_MODULE_LINKER_FLAGS": "/machine:X86",
        "DXP_ARCH": "x86",
        "DXP_CRT": "Static"
      }
    },
    {
      "name": "clang-x64-static",
      "inherits": "base",
      "displayName": "Clang x64 (Static CRT /MT)",
      "description": "Clang-cl + Ninja (SM5 + SM6)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "DXP_CRT": "Static"
      }
    },
    {
      "name": "clang-x86-static",
      "inherits": "base",
      "displayName": "Clang x86 (Static CRT /MT)",
      "description": "SM5-only build (no LLVM/DXIL)",
      "binaryDir": "${sourceDir}/out/build32/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_MODULE_LINKER_FLAGS": "/machine:X86",
        "CMAKE_STATIC_LINKER_FLAGS": "/machine:X86",
        "DXP_ARCH": "x86",
        "DXP_CRT": "Static"
      }
    }
  ],
