{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DXP_ENABLE_COMPILER_CACHE": "ON",
        "LLVM_ENABLE_ASSERTIONS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ninja-clang-base",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "ENABLE_SPIRV_CODEGEN": "OFF",
        "LLVM_ENABLE_WERROR": "OFF",
        "SPIRV_WERROR": "OFF"
      }
    },
    {
      "name": "x64-debug",
      "inherits": "ninja-base",
      "displayName": "x64 Debug (Ninja)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "x64-release",
      "inherits": "ninja-base",
      "displayName": "x64 Release (Ninja)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "x64-clang-release",
      "inherits": "ninja-clang-base",
      "displayName": "x64 Release (clang-cl, Ninja)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-clang-release",
      "configurePreset": "x64-clang-release"
    },
    {
      "name": "tool-debug",
      "configurePreset": "x64-debug",
      "targets": [
        "dxp"
      ]
    },
    {
      "name": "tool-clang-release",
      "configurePreset": "x64-clang-release",
      "targets": [
        "dxp"
      ]
    }
  ]
}