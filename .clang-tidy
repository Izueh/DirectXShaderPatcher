# https://clang.llvm.org/extra/clang-tidy/checks/list.html
---
Checks:
  - bugprone-*
  - cppcoreguidelines-*
  - google-*
  - llvm-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  - -llvm-header-guard
  - -llvm-include-order
  - -modernize-use-trailing-return-type
  - -misc-non-private-member-variables-in-classes
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -misc-unused-parameters
  - -misc-use-internal-linkage
  - -readability-function-cognitive-complexity
  - -readability-magic-numbers
  - -readability-uppercase-literal-suffix
  - -readability-identifier-length
CheckOptions:
  readability-braces-around-statements.ShortStatementLines: 1
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: _
  readability-identifier-naming.ClassMethodCase: CamelCase
  readability-identifier-naming.ConstantCase: CamelCase
  readability-identifier-naming.ConstantMemberCase: UPPER_CASE
  readability-identifier-naming.ConstantParameterCase: lower_case
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.GlobalFunctionCase: CamelCase
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.VariableCase: lower_case
  # Existing code uses k-prefix constants (kOpcode) and camelCase locals (stepOrErr)
  # in newer files; both are grandfathered while new code follows the case rules.
  # Additionally, glaze library members (keys/value/values/validate/tag/ids) keep
  # their required lowercase names, and DXIL float-format enumerators (F8_*) follow
  # the D3D naming convention.
  readability-identifier-naming.ClassConstantIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*|value|values|keys|validate|tag|ids|F8_.*)"
  readability-identifier-naming.ConstantIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*|value|values|keys|validate|tag|ids|F8_.*)"
  readability-identifier-naming.StaticConstantIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*|value|values|keys|validate|tag|ids|F8_.*)"
  readability-identifier-naming.LocalConstantIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*)"
  readability-identifier-naming.LocalVariableIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*)"
  readability-identifier-naming.ParameterIgnoredRegexp: "^(k[A-Z]|[a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*)"
  # WinIncludes.h/dxcapi.h are intentionally included for COM init ordering and
  # NOMINMAX (WinIncludes.h defines NOMINMAX so std::max/min survive). Never flag
  # them as unused or let the fixer atomize them.
  misc-include-cleaner.IgnoreHeaders: 'WinIncludes\.h;dxcapi\.h'

WarningsAsErrors: ""
HeaderFilterRegex: ".*.hpp"
HeaderFileExtensions: ["", "h", "hh", "hpp", "hxx"]
ImplementationFileExtensions: ["c", "cc", "cpp", "cxx"]
